# ScholarTrack Environment Variables
# Copy this file to .env and adjust values for local development or deployment

SECRET_KEY=replace-with-a-random-secure-secret-key-32-chars-min
DATABASE_URL=sqlite:///instance/scholartrack.db
SCRAPING_INTERVAL_MINUTES=60
REQUEST_TIMEOUT_SECONDS=10
MAX_RETRIES=3
BACKOFF_FACTOR=1.5
RESPECT_ROBOTS_TXT=True
CRAWLER_USER_AGENT=ScholarTrackBot/2.0 (+https://scholartrack.edu/bot; educational scholarship research)
APPROVED_HOSTS=localhost,127.0.0.1,example.edu,example.org,grants.gov,nsf.gov,fulbrightonline.org,daad.de,reliancefoundation.org,buddy4study.com,scholarships.gov.in,gov.in,nic.in,pmrf.in,turing.ac.uk,ox.ac.uk,europa.eu,who.int,usief.org.in

# Initial Admin Bootstrap Credentials
ADMIN_EMAIL=admin@scholartrack.edu
ADMIN_PASSWORD=Admin@ScholarTrack2026!
ADMIN_NAME=ScholarTrack Lead Admin
